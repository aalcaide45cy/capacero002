{
    "redirects": [
        {
            "source": "/cursos",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/cursos/:path*",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/v2-back",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/v2-back/:path*",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/producto/:path*",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/v4",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/v4/:path*",
            "destination": "/",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/video/:slug",
            "destination": "/video/:slug/index.html"
        },
        {
            "source": "/tp",
            "destination": "/tp/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        }
    ],
    "crons": [
        {
            "path": "/api/cron-sync",
            "schedule": "0 7 * * *"
        }
    ]
}
