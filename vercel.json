{
    "redirects": [
        {
            "source": "/cursos",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/cursos/:path*",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/v2-back",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/v2-back/:path*",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/v4",
            "destination": "/",
            "permanent": true
        },
        {
            "source": "/v4/:path*",
            "destination": "/",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/api/dieta/:path*",
            "destination": "/api/admin?p=dieta/:path*"
        },
        {
            "source": "/admin",
            "destination": "/api/admin"
        },
        {
            "source": "/admin/:path*",
            "destination": "/api/admin?p=:path*"
        },
        {
            "source": "/producto/:path*",
            "destination": "/api/admin?p=gone"
        },
        {
            "source": "/video/:slug",
            "destination": "/video/:slug/index.html"
        },
        {
            "source": "/tp",
            "destination": "/tp/index.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache, no-store, must-revalidate"
                }
            ]
        },
        {
            "source": "/dieta/:path*",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow"
                },
                {
                    "key": "Cache-Control",
                    "value": "no-store, private"
                }
            ]
        },
        {
            "source": "/dieta",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow"
                },
                {
                    "key": "Cache-Control",
                    "value": "no-store, private"
                }
            ]
        }
    ],
    "crons": [
        {
            "path": "/api/cron-sync",
            "schedule": "0 7 * * *"
        }
    ]
}
