{
  "manifest_version": 3,
  "name": "Llamar con iPhone",
  "version": "1.0.0",
  "description": "Selecciona un teléfono, un texto con número o un enlace y tu iPhone recibe una notificación para llamar con un toque.",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Llamar con iPhone (opciones)", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "permissions": ["contextMenus", "storage", "activeTab", "scripting", "notifications"],
  "host_permissions": ["https://capacero3d.com/*", "https://www.capacero3d.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "commands": {
    "send-selection": {
      "suggested_key": { "default": "Alt+Shift+L", "mac": "Alt+Shift+L" },
      "description": "Enviar la selección al iPhone"
    }
  }
}
